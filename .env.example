# ============================================================================
# hub_amyris — variáveis de ambiente (na Vercel, cadastre SEM aspas)
# ============================================================================

# Banco de dados (Postgres). Espelhamento de usuários e regras de acesso locais.
# Exemplo: postgresql://USER:PASSWORD@HOST:PORT/db_amyris
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/db_amyris

# Banco db_inhaus (Postgres) — conexão SEPARADA, só para o indicador de Headcount
# (leitura da view public.vw_ponto_amyris). NÃO é a mesma conexão do DATABASE_URL acima.
DATABASE_URL_INHAUS=postgresql://USER:PASSWORD@HOST:PORT/db_inhaus

# ---- Integração global_auth (apenas o método de autenticação) ----
AUTH_BASE_URL=http://HOST:PORT
AUTH_API_KEY=ga_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Duração dos cookies da sessão (opcional). Padrão: acesso 12h, refresh 90 dias.
AUTH_ACCESS_COOKIE_MAX_AGE_SECONDS=43200
AUTH_REFRESH_COOKIE_MAX_AGE_SECONDS=7776000

# Admin(s) bootstrap (sempre entram como admin). Separe por vírgula.
BOOTSTRAP_ADMIN_EMAILS=admin@example.com
